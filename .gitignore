# Large, regenerable data (raw orderbook hourly files + processed snapshots).
# Recreated by pipeline.py; do NOT commit. Matches any module's data/ dir.
**/data/

# Python
__pycache__/
*.pyc

# Logs / error dumps
*.log
*.err

# Project data
.codebuddy/
# kk（kaggle-runner）本地缓存：产物 + 嵌套克隆，不进仓库
.kk/
# 本地临时/验证脚手架（脚本、抽样 parquet、运行日志）
tmp/
